/* =========================================================
HOME — Portal Vivência
========================================================= */

.home-body {
  min-height: 100vh;
  background: var(--cor-fundo);
  color: var(--cor-texto);
}

/* =========================================================
NAV
========================================================= */

.home-body .nav {
  width: 100%;
  min-height: 72px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(var(--cor-superficie), 0.94);
  border-bottom: 1px solid var(--cor-borda);

  position: relative;
  z-index: 10;
}

.home-body .nav__marca {
  display: flex;
  align-items: center;
  gap: 10px;

  text-decoration: none;

  color: var(--cor-nav-texto);
}

